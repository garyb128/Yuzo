<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Yuzo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Yuzo.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutWidth="210"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
    Shell.UnselectedColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="72" ColumnDefinitions="36,*" ColumnSpacing="10" Padding="18,12">
            <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}">
                <Label Text="♪" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
            </Border>
            <Label Grid.Column="1" Text="Yuzo" FontSize="19" FontAttributes="Bold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Library" Route="library">
        <ShellContent ContentTemplate="{DataTemplate views:LibraryPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Quiz" Route="quiz">
        <ShellContent ContentTemplate="{DataTemplate views:QuizPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Playlists" Route="playlists">
        <ShellContent ContentTemplate="{DataTemplate views:PlaylistsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Settings" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>
</Shell>